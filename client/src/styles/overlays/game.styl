
#game_overlay {
    z-index: 4;
    .scanner-target {
        position: absolute;
        z-index: 0;
        
        .targeting-effect {
            display: none;
            width: 40px;
            height: 40px;
            position: absolute;
            right: -7.5px;
            bottom: -7.5px;
            animation: scale 0.6s infinite ease-in-out;

            ^[-1].tracking ^[2..2] {
                display: block;
            }

            ^[-1].locking ^[2..2] {
                animation: scale 0.3s infinite ease-in-out;
            }

            ^[-1].locked ^[2..2] {
                animation: none;
            }

            .border {
                border-radius: 100%;
                border: dashed 1px rgba(200, 0, 200, 1);
                width: 100%;
                height: 100%;
                animation: rotate 5s infinite linear;

                ^[-2].locking ^[3..3] {
                    animation: rotate 2.5s infinite linear;
                }
                ^[-2].locked ^[3..3] {
                    border: ridge 2px rgba(200, 0, 200, 1);
                    animation: none;
                }
            }

        }

        &.aircraft  {
            & path, 
            & rect {
                stroke-width: 20px;
            }
        }

        &.ship {
            & path, 
            & rect {
                stroke-width: 10px;
            }
        }

        &.structure {
            & path, 
            & rect {
                stroke-width: 15px;
            }
        }
    
        .symbol {
            background: none;
            width: 20px;
            height: 20px;

            path, rect {
                stroke: rgba(0, 0, 200, 0.5);
                fill: none;
            }

            ^[-1].tracking ^[2..2] {
                path, rect {
                    fill: rgba(200, 0, 200, 0.5);
                    stroke: rgba(200, 0, 200, 1);
                }
            }
        }

    }

    #hud {
        &-lines {
            position: absolute;
            border-left: 4px ridge rgb(0, 0, 100);
            border-right: 4px ridge rgb(0, 0, 100);
            top: 37.5dvh;
            left: 37.5dvw;
            width: 25dvw;
            height: 25dvh;
            border-radius: 10% / 50%;
            z-index: 2;
            pointer-events: none;
        }

        &-aspd,
        &-vspd,
        &-head,
        &-elev {
            position: absolute;
            color: rgb(0, 0, 100);
            font-family: monospace;
            z-index: 2;
            pointer-events: none;
        }
        &-aspd {
            bottom: 31.25dvh;
            left: 31.25dvw;
        }
        &-vspd {
            bottom: 31.25dvh;
            right: 31.25dvw;
        }
        &-head {
            top: 31.25dvh;
            left: 31.25dvw;
        }
        &-elev {
            top: 31.25dvh;
            right: 31.25dvw;
        }
        
        // Portrait mode styles
        ^[1].portrait ^[1..1]-lines {
            left: calc(37.5dvw / 2);
            width: 62.5dvw;
        }

        ^[1].portrait ^[1..1]-aspd {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-vspd {
            right: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-head {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-elev {
            right: 15.625dvw;
        }
        
    }

    #depart_prompt {
        position: absolute;
        left: 50%;
        bottom: @css{ max(15rem, 32dvh) };
        z-index: 3;
        width: @css{ min(22rem, calc(100dvw - 2rem)) };
        padding: 1rem 1.15rem;
        color: #d7f7ff;
        font-family: ui-monospace, Menlo, Consolas, monospace;
        background: rgba(4, 12, 28, 0.9);
        border: 2px ridge rgb(0, 40, 120);
        border-radius: 6px;
        box-shadow: 0 0 24px rgba(0, 180, 220, 0.18);
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 10px);
        transition: opacity 180ms ease, transform 180ms ease;
        user-select: none;

        &.visible {
            opacity: 1;
            pointer-events: auto;
            transform: translate(-50%, 0);
        }

        p {
            margin: 0 0 0.35rem;
            color: rgba(215, 247, 255, 0.75);
            font-size: 0.85rem;
            &:first-child {
                color: #00eeff;
                font-size: 0.7rem;
                letter-spacing: 0.22em;
                text-transform: uppercase;
            }
        }

        h2 {
            margin: 0 0 0.35rem;
            color: #fff;
            font-size: 1.15rem;
        }

        div {
            display: flex;
            gap: 0.65rem;
            margin-top: 0.6rem;
        }

        button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            min-height: 44px;
            padding: 0.45rem 0.85rem;
            color: rgba(215, 247, 255, 0.85);
            font: inherit;
            font-size: 0.8rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            cursor: pointer;
            background: transparent;
            border: 1px solid rgba(0, 160, 200, 0.35);
            border-radius: 4px;
        }

        button:first-child {
            flex: 1;
            color: #041018;
            background: #00c8e0;
            border-color: #9ffffb;
        }

        kbd {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.7rem;
            height: 1.7rem;
            color: #00eeff;
            font-size: 0.72rem;
            letter-spacing: 0;
            text-transform: none;
            background: rgba(0, 8, 24, 0.85);
            border: 1px solid rgba(0, 238, 255, 0.55);
            border-radius: 3px;
        }

        button:first-child kbd {
            color: #032028;
            background: rgba(255, 255, 255, 0.72);
            border-color: rgba(0, 40, 60, 0.3);
        }
    }

    #map {
        display: none;
        position: absolute;
        height: @css{ max(12.5dvw, 12.5dvh) };
        width: @css{ max(12.5dvw, 12.5dvh) };
        background: radial-gradient(rgba(#333, 0.15) 5%, rgba(#333, 0.35) 95%);
        border-radius: 100%;
        top: @css{ min(2.5dvw, 2.5dvh) };
        left: @css{ min(2.5dvw, 2.5dvh) };

        #map-fov {
            height: 15px;
            position: absolute;
            left: calc( 50% - 7.5px );
            top: calc( 50% - 7.5px );
        }

        .marker {
            width: 10px;
            height: 10px;
            position: absolute;
        }
    }

}

@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

@keyframes scale {
    0%, 100% {
        transform: scale(0.8);
    }
    50% {
        transform: scale(1.2);
    }
}
