
#game_overlay {
    z-index: 4;

    // Person-mode inventory control (HUD is inactive on foot indoors).
    // Bottom-centre keeps the right half free for touch camera look.
    > .person-inventory-button {
        position: absolute;
        left: 50%;
        right: auto;
        bottom: @css{ min(3.5dvw, 3.5dvh) };
        transform: translateX(-50%);
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 0.45rem;
        box-sizing: border-box;
        min-width: 5.5rem;
        margin: 0;
        padding: 0.45rem 0.45rem 0.2rem;
        border-style: solid;
        border-color: transparent;
        border-width: 16px;
        border-image-source: url("/assets/borders/border-05.png");
        border-image-slice: unquote("80 fill");
        border-image-width: 28px;
        border-image-repeat: round;
        background-color: transparent;
        background-clip: padding-box;
        color: rgb(0, 255, 0);
        pointer-events: auto;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
        -webkit-user-select: none;

        &[hidden] {
            display: none;
        }

        &:hover,
        &:focus-visible,
        &:active {
            border-image-source: url("/assets/borders/border-07.png");
            outline: none;
        }

        .inventory-icon {
            display: block;
            width: 58px;
            height: 58px;
            flex: 0 0 auto;
            margin: auto 0;
            filter: drop-shadow(0 0 3px rgba(0, 0, 0, 0.85));
        }

        .inventory-meta {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
        }

        // Shared .window_hotkey, tinted to match HUD green.
        .window_hotkey {
            margin-right: 0;
            background: rgba(0, 0, 0, 0.45);
            border-color: rgba(0, 255, 0, 0.55);
            text-shadow: none;
        }

        .inventory-label {
            color: rgb(0, 255, 0);
            font-family: monospace;
            font-size: 0.62rem;
            letter-spacing: 0.12em;
            line-height: 1;
            text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
            white-space: nowrap;
        }
    }

    .scanner-target {
        position: absolute;
        z-index: 0;
        
        .targeting-effect {
            display: none;
            width: 40px;
            height: 40px;
            position: absolute;
            right: -7.5px;
            bottom: -7.5px;
            animation: scale 0.6s infinite ease-in-out;

            ^[-1].tracking ^[2..2] {
                display: block;
            }

            ^[-1].locking ^[2..2] {
                animation: scale 0.3s infinite ease-in-out;
            }

            ^[-1].locked ^[2..2] {
                animation: none;
            }

            .border {
                border-radius: 100%;
                border: dashed 1px rgba(200, 0, 200, 1);
                width: 100%;
                height: 100%;
                animation: rotate 5s infinite linear;

                ^[-2].locking ^[3..3] {
                    animation: rotate 2.5s infinite linear;
                }
                ^[-2].locked ^[3..3] {
                    border: ridge 2px rgba(200, 0, 200, 1);
                    animation: none;
                }
            }

        }

        &.aircraft  {
            & path, 
            & rect {
                stroke-width: 20px;
            }
        }

        &.ship {
            & path, 
            & rect {
                stroke-width: 10px;
            }
        }

        &.structure {
            & path, 
            & rect {
                stroke-width: 15px;
            }
        }
    
        .symbol {
            background: none;
            width: 20px;
            height: 20px;

            path, rect {
                stroke: rgba(0, 0, 200, 0.5);
                fill: none;
            }

            ^[-1].tracking ^[2..2] {
                path, rect {
                    fill: rgba(200, 0, 200, 0.5);
                    stroke: rgba(200, 0, 200, 1);
                }
            }
        }

    }

    #hud {
        &-lines {
            position: absolute;
            border-left: 4px ridge rgb(0, 0, 100);
            border-right: 4px ridge rgb(0, 0, 100);
            top: 37.5dvh;
            left: 37.5dvw;
            width: 25dvw;
            height: 25dvh;
            border-radius: 10% / 50%;
            z-index: 2;
            pointer-events: none;
        }

        &-aspd,
        &-vspd,
        &-head,
        &-elev {
            position: absolute;
            color: rgb(0, 0, 100);
            font-family: monospace;
            z-index: 2;
            pointer-events: none;
        }
        &-aspd {
            bottom: 31.25dvh;
            left: 31.25dvw;
        }
        &-vspd {
            bottom: 31.25dvh;
            right: 31.25dvw;
        }
        &-head {
            top: 31.25dvh;
            left: 31.25dvw;
        }
        &-elev {
            top: 31.25dvh;
            right: 31.25dvw;
        }

        &-capacitor-panel {
            position: absolute;
            left: 50%;
            bottom: @css{ min(3.5dvw, 3.5dvh) };
            transform: translateX(-50%);
            display: flex;
            align-items: stretch;
            gap: 0.55rem;
            z-index: 2;
            pointer-events: none;
        }

        // Afterburner + inventory (+ future actions). Desktop rides in the capacitor row.
        .hud-systems {
            display: flex;
            align-items: stretch;
            gap: 0.55rem;
            pointer-events: none;

            > * {
                pointer-events: auto;
            }
        }

        &-capacitor {
            position: relative;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 0.35rem;
            width: 299px;
            min-height: 96px;
            padding: 0.7rem 1.05rem 0.65rem;
            pointer-events: none;
            background: url("/assets/borders/border-09.png") center / 100% 100% no-repeat;

            .fuel-badge {
                display: flex;
                align-items: center;
                gap: 0.35rem;
                min-height: 1.1rem;
                pointer-events: none;
            }

            .crystal-icon {
                width: 1.05rem;
                height: 1.05rem;
                object-fit: contain;
                flex-shrink: 0;
                image-rendering: auto;
            }

            .crystal-count {
                color: rgb(0, 255, 0);
                font-family: monospace;
                font-size: 0.78rem;
                letter-spacing: 0.06em;
                line-height: 1;
                text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
            }

            .low-power-label {
                display: none;
                margin-left: auto;
                color: rgb(255, 170, 60);
                font-family: monospace;
                font-size: 0.58rem;
                letter-spacing: 0.14em;
                line-height: 1;
                text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
            }

            .fuel-rows {
                display: flex;
                flex-direction: column;
                gap: 0.28rem;
            }

            .fuel-row {
                display: grid;
                grid-template-columns: 2.2rem 1fr 3.4rem;
                align-items: center;
                column-gap: 0.35rem;
            }

            .row-label {
                color: rgb(0, 255, 0);
                font-family: monospace;
                font-size: 0.62rem;
                letter-spacing: 0.1em;
                line-height: 1;
                text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
            }

            .readout {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 0.28rem;
                min-width: 0;
            }

            .pct {
                color: rgb(0, 255, 0);
                font-family: monospace;
                font-size: 0.72rem;
                letter-spacing: 0.04em;
                text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
                line-height: 1;
                white-space: nowrap;
            }

            .trend {
                width: 0;
                height: 0;
                border-left: 4px solid transparent;
                border-right: 4px solid transparent;
                flex-shrink: 0;

                &.up {
                    border-bottom: 6px solid rgb(80, 180, 255);
                    border-top: 0;
                }

                &.down {
                    border-top: 6px solid rgb(255, 170, 60);
                    border-bottom: 0;
                }

                &.steady {
                    width: 5px;
                    height: 2px;
                    border: 0;
                    background: rgba(0, 255, 0, 0.55);
                }
            }

            .track {
                position: relative;
                height: 9px;
                border-radius: 999px;
                background: rgba(0, 0, 40, 0.55);
                overflow: visible;
            }

            .segments {
                position: absolute;
                inset: 0;
                display: flex;
                gap: 2px;
                padding: 2px;
                border-radius: inherit;
                overflow: hidden;
            }

            .seg {
                flex: 1 1 0;
                min-width: 0;
                border-radius: 1px;
                background: rgba(30, 40, 70, 0.85);
            }

            .fuel-row.cap .seg.on {
                background: linear-gradient(180deg, rgb(80, 180, 255), rgb(20, 90, 180));
                box-shadow: inset 0 0 4px rgba(180, 230, 255, 0.35);
            }

            .fuel-row.pwr .seg.on {
                background: linear-gradient(180deg, rgb(255, 90, 70), rgb(140, 20, 30));
                box-shadow: inset 0 0 4px rgba(255, 160, 140, 0.3);
            }

            .fuel-row.pwr.in-use .seg.on {
                background: linear-gradient(180deg, rgb(190, 110, 255), rgb(90, 30, 160));
                box-shadow: inset 0 0 4px rgba(220, 180, 255, 0.35);
            }

            .caret {
                position: absolute;
                top: -6px;
                width: 0;
                height: 0;
                margin-left: -4px;
                border-left: 4px solid transparent;
                border-right: 4px solid transparent;
                border-top: 5px solid rgb(0, 255, 0);
                transform: translateX(-50%);
                pointer-events: none;
            }

            &.charging .fuel-row.cap .pct {
                color: rgb(80, 180, 255);
            }

            &.draining .fuel-row.cap .pct {
                color: rgb(255, 170, 60);
            }

            &.draining .fuel-row.cap .seg.on {
                background: linear-gradient(180deg, rgb(255, 170, 60), rgb(160, 70, 20));
            }

            &.empty .fuel-row.cap .seg.on {
                background: rgb(60, 60, 80);
            }

            &.low-power {
                .fuel-row.cap .pct,
                .crystal-count {
                    color: rgb(255, 170, 60);
                }

                .low-power-label {
                    display: inline;
                    animation: hud-low-power-pulse 1.1s ease-in-out infinite;
                }
            }

            &.auto-off .caret {
                display: none;
            }
        }

        .inventory-button {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            gap: 0.45rem;
            box-sizing: border-box;
            align-self: stretch;
            min-width: 5.5rem;
            margin: 0;
            padding: 0.45rem 0.45rem 0.2rem;
            border-style: solid;
            border-color: transparent;
            border-width: 16px;
            border-image-source: url("/assets/borders/border-05.png");
            border-image-slice: unquote("80 fill");
            border-image-width: 28px;
            border-image-repeat: round;
            background-color: transparent;
            background-clip: padding-box;
            color: rgb(0, 255, 0);
            pointer-events: auto;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            -webkit-user-select: none;

            &:hover,
            &:focus-visible,
            &:active {
                border-image-source: url("/assets/borders/border-07.png");
                outline: none;
            }
        }

        .inventory-icon {
            display: block;
            width: 58px;
            height: 58px;
            flex: 0 0 auto;
            margin: auto 0;
            filter: drop-shadow(0 0 3px rgba(0, 0, 0, 0.85));
        }

        .inventory-meta {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
        }

        .window_hotkey {
            margin-right: 0;
            background: rgba(0, 0, 0, 0.45);
            border-color: rgba(0, 255, 0, 0.55);
            text-shadow: none;
        }

        .inventory-label {
            color: rgb(0, 255, 0);
            font-family: monospace;
            font-size: 0.62rem;
            letter-spacing: 0.12em;
            line-height: 1;
            text-shadow: 0 0 4px rgba(0, 0, 0, 0.85);
            white-space: nowrap;
        }

        .afterburner-controls {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: space-between;
            box-sizing: border-box;
            min-width: 5.5rem;
            padding: 0.2rem 0.2rem 0.1rem;
            border-style: solid;
            border-color: transparent;
            border-width: 16px;
            border-image-source: url("/assets/borders/border-05.png");
            border-image-slice: unquote("80 fill");
            border-image-width: 28px;
            border-image-repeat: round;
            background-color: transparent;
            background-clip: padding-box;
            pointer-events: auto;

            &.auto-on {
                border-image-source: url("/assets/borders/border-07.png");
            }

            // Compact slideout: body collapses; lamp + label stay as the handle.
            &.tray .afterburner-body {
                overflow: hidden;
                max-height: 7.5rem;
                opacity: 1;
                transition: max-height 0.22s ease, opacity 0.18s ease, margin 0.18s ease;
            }

            &.tray.collapsed {
                min-width: 0;
                padding: 0.12rem 0.45rem 0.1rem;
                border-width: 8px;
                border-image-width: 14px;

                .afterburner-body {
                    max-height: 0;
                    opacity: 0;
                    margin: 0;
                    pointer-events: none;
                }

                .afterburner-footer {
                    margin: 0;
                }
            }

            &.tray.expanded {
                border-width: 10px;
                border-image-width: 18px;
            }

            &.tray .afterburner-footer {
                pointer-events: auto;
                cursor: pointer;
                touch-action: none;
                -webkit-tap-highlight-color: transparent;
                user-select: none;
                -webkit-user-select: none;
            }

            &.tray .afterburner-chevron {
                display: block;
            }
        }

        .afterburner-footer {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            margin: 0.25rem 0 0;
            pointer-events: none;
        }

        // Hidden on desktop full panel; tray mode shows open/collapse affordance.
        .afterburner-chevron {
            display: none;
            flex: 0 0 auto;
            width: 0;
            height: 0;
            margin-top: -1px;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-bottom: 5px solid rgb(0, 255, 0);
            opacity: 0.85;
            filter: drop-shadow(0 0 3px rgba(0, 255, 120, 0.35));
            transition: transform 0.18s ease;
        }

        .afterburner-controls.tray.collapsed .afterburner-chevron {
            // Points open-ward (up locally → into screen on bottom tray / right on side tray).
            transform: none;
        }

        .afterburner-controls.tray.expanded .afterburner-chevron {
            // Points close-ward after opening.
            transform: rotate(180deg);
        }

        .afterburner-lamp {
            flex: 0 0 auto;
            width: 8px;
            height: 8px;
            margin-top: -2px;
            border-radius: 100%;
            border: 1px solid rgba(40, 50, 60, 0.7);
            background: @css{
                radial-gradient(circle at 35% 30%, rgba(70, 80, 90, 0.55) 0%, rgba(10, 12, 16, 0.95) 70%)
            };
            box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.8);

            &.on {
                border-color: rgba(0, 220, 120, 0.65);
                background: @css{
                    radial-gradient(circle at 35% 30%, rgba(180, 255, 200, 0.95) 0%, rgba(0, 220, 90, 0.85) 45%, rgba(0, 80, 40, 0.9) 100%)
                };
                box-shadow: 0 0 6px rgba(0, 255, 120, 0.55), inset 0 0 2px rgba(255, 255, 255, 0.35);
            }
        }

        .afterburner-label {
            margin: 0;
            text-align: center;
            color: rgb(0, 255, 0);
            font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif;
            font-style: italic;
            font-weight: 700;
            font-size: 0.68rem;
            letter-spacing: 0.12em;
            line-height: 1.1;
            text-transform: uppercase;
            text-shadow: 0 1px 6px rgba(0, 10, 40, 0.55);
            pointer-events: none;
        }

        .afterburner-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.2rem;
        }

        .auto-switch {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            margin: 0;
            padding: 0.15rem 0.45rem;
            border: 1px solid rgba(0, 160, 220, 0.35);
            border-radius: 2px;
            background: rgba(0, 8, 24, 0.55);
            color: rgb(0, 255, 0);
            font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif;
            font-style: italic;
            font-weight: 700;
            font-size: 0.68rem;
            letter-spacing: 0.1em;
            line-height: 1.1;
            text-transform: uppercase;
            text-shadow: 0 1px 6px rgba(0, 10, 40, 0.55);
            cursor: pointer;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;

            &:hover,
            &:focus-visible,
            &.on {
                border-color: rgba(0, 220, 255, 0.75);
                background: rgba(0, 40, 70, 0.65);
            }

            &:focus-visible {
                outline: none;
            }

            &:not(.on) {
                color: rgb(140, 160, 140);
                border-color: rgba(80, 90, 100, 0.45);
            }
        }

        .threshold-dial {
            position: relative;
            box-sizing: border-box;
            width: 58px;
            height: 58px;
            border: 1px solid rgba(0, 160, 220, 0.35);
            border-radius: 100%;
            background: @css{
                radial-gradient(circle at 50% 40%, rgba(50, 60, 70, 0.55) 0%, rgba(0, 0, 0, 0.85) 70%)
            };
            box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.65);
            cursor: grab;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;

            .face {
                position: absolute;
                inset: 14%;
                border-radius: 100%;
                border: 1px solid rgba(0, 160, 220, 0.25);
                background: rgba(0, 8, 24, 0.5);
                pointer-events: none;
            }

            .needle {
                position: absolute;
                left: 50%;
                bottom: 50%;
                width: 2px;
                height: 30%;
                margin: 0;
                background: rgb(0, 255, 0);
                transform-origin: 50% 100%;
                transform: translateX(-50%) rotate(-67.5deg);
                border-radius: 1px;
                pointer-events: none;
                box-shadow: 0 0 4px rgba(0, 255, 0, 0.45);
            }

            .dial-value {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 18%;
                text-align: center;
                color: rgb(0, 255, 0);
                font-family: monospace;
                font-size: 0.58rem;
                letter-spacing: 0.04em;
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
                pointer-events: none;
            }

            &.active,
            &:hover,
            &:focus-visible {
                border-color: rgba(0, 220, 255, 0.75);
            }

            &.active {
                cursor: grabbing;
            }

            &.disabled {
                opacity: 0.4;
                pointer-events: none;
                filter: grayscale(0.35);
            }
        }
        
        // Portrait mode styles
        ^[1].portrait ^[1..1]-lines {
            left: calc(37.5dvw / 2);
            width: 62.5dvw;
        }

        ^[1].portrait ^[1..1]-aspd {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-vspd {
            right: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-head {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-elev {
            right: 15.625dvw;
        }

        // Compact (phones): capacitor up top; afterburner is a bottom slideout tray.
        ^[1].compact ^[1..1]-capacitor-panel {
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            transform: none;
            display: block;
            gap: 0;
            max-width: none;
            pointer-events: none;
        }

        ^[1].compact ^[1..1]-capacitor {
            position: absolute;
            // Sit to the right of #map with a small gap (map: left + size).
            left: calc(@css{ min(2.5dvw, 2.5dvh) } + @css{ max(12.5dvw, 12.5dvh) } + 0.75rem);
            top: @css{ min(2.5dvw, 2.5dvh) };
            transform: none;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 0.2rem;
            width: 202px;
            min-height: 72px;
            padding: 0.45rem 0.8rem 0.4rem;

            .fuel-badge {
                gap: 0.22rem;
                min-height: 0.85rem;
            }

            .crystal-icon {
                width: 0.8rem;
                height: 0.8rem;
            }

            .crystal-count {
                font-size: 0.5rem;
                letter-spacing: 0.04em;
            }

            // Compact bar is too short for the desktop LOW POWER banner.
            .low-power-label {
                display: none !important;
            }

            .fuel-rows {
                gap: 0.18rem;
            }

            .fuel-row {
                grid-template-columns: 1.7rem 1fr 2.6rem;
                column-gap: 0.22rem;
            }

            .row-label {
                font-size: 0.45rem;
                letter-spacing: 0.08em;
            }

            .readout {
                gap: 0.16rem;
            }

            .pct {
                font-size: 0.45rem;
                letter-spacing: 0.03em;
            }

            .trend {
                border-left-width: 3px;
                border-right-width: 3px;

                &.up {
                    border-bottom-width: 4px;
                }

                &.down {
                    border-top-width: 4px;
                }

                &.steady {
                    width: 4px;
                    height: 1px;
                }
            }

            .track {
                height: 7px;
            }

            .segments {
                gap: 1px;
                padding: 1px;
            }

            .caret {
                top: -5px;
                border-left-width: 3px;
                border-right-width: 3px;
                border-top-width: 4px;
                margin-left: -3px;
            }
        }

        // Landscape compact: systems strip between D-pad and attack controls.
        // Flex row so more action tabs can join without re-centering math.
        // Shared tab tokens keep afterburner + inventory the same height (landscape)
        // and the same width (portrait side tabs).
        ^[1].compact .hud-systems {
            position: absolute;
            left: calc(@css{ min(2.5dvw, 2.5dvh) } + @css{ max(8vw, 8vh, 160px) } + 0.75rem);
            right: auto;
            bottom: @css{ min(2.5dvw, 2.5dvh) };
            transform: none;
            align-items: flex-end;
            gap: 0.45rem;
            z-index: 3;
            --hud-tab-padding: 0.12rem 0.5rem 0.1rem;
            --hud-tab-border-width: 8px;
            --hud-tab-border-image-width: 14px;
            --hud-tab-min-height: 2.4rem;
            --hud-tab-label-size: 0.5rem;
            --hud-tab-label-tracking: 0.1em;
            --hud-side-tab-width: 2.25rem;
            --hud-side-tab-padding: 0.55rem 0.28rem;
            --hud-side-tab-border-width: 7px;
            --hud-side-tab-border-image-width: 12px;
        }

        // Wide/landscape compact: tray flush in the systems strip.
        // Handle (label tab) stays compact; dial/AUTO are larger for touch.
        ^[1].compact .afterburner-controls {
            position: relative;
            left: auto;
            bottom: auto;
            transform: none;
            min-width: 0;
            padding: 0.2rem 0.28rem 0.12rem;
            border-width: 12px;
            border-image-width: 22px;
            z-index: 3;
        }

        // Compact inventory: slim chrome tab beside afterburner in the systems strip.
        ^[1].compact .inventory-button {
            position: relative;
            left: auto;
            bottom: auto;
            box-sizing: border-box;
            min-width: 0;
            min-height: var(--hud-tab-min-height);
            padding: var(--hud-tab-padding);
            border-width: var(--hud-tab-border-width);
            border-image-width: var(--hud-tab-border-image-width);
            gap: 0;
            justify-content: center;
            z-index: 3;
        }

        ^[1].compact .inventory-icon {
            display: none;
        }

        ^[1].compact .inventory-meta {
            gap: 0.25rem;
        }

        ^[1].compact .window_hotkey {
            min-width: 0.95rem;
            height: 0.95rem;
            font-size: 0.58rem;
        }

        ^[1].compact .inventory-label,
        ^[1].compact .afterburner-label {
            font-size: var(--hud-tab-label-size);
            letter-spacing: var(--hud-tab-label-tracking);
        }

        ^[1].compact .afterburner-controls.tray.collapsed {
            box-sizing: border-box;
            min-height: var(--hud-tab-min-height);
            padding: var(--hud-tab-padding);
            border-width: var(--hud-tab-border-width);
            border-image-width: var(--hud-tab-border-image-width);
            justify-content: center;
        }

        ^[1].compact .afterburner-controls.tray.expanded {
            border-width: 12px;
            border-image-width: 22px;
        }

        ^[1].compact .afterburner-body {
            gap: 0.28rem;
        }

        ^[1].compact .afterburner-footer {
            gap: 0.25rem;
            margin: 0.15rem 0 0;
        }

        ^[1].compact .afterburner-lamp {
            width: 7px;
            height: 7px;
        }

        ^[1].compact .threshold-dial {
            width: 88px;
            height: 88px;

            .dial-value {
                font-size: 0.95rem;
            }
        }

        ^[1].compact .auto-switch {
            padding: 0.22rem 0.65rem;
            font-size: 1.05rem;
            letter-spacing: 0.08em;
        }

        ^[1].compact.portrait ^[1..1]-capacitor {
            // Dock under session chrome so the gauge clears #map on thin phones.
            // Chrome: top 1.15rem / right 1.4rem; window_action ~60px; gap 0.55rem.
            left: auto;
            right: 1.4rem;
            top: calc(1.15rem + 60px + 0.55rem);
            transform: none;
            width: 179px;
            min-height: 68px;
        }

        // Portrait: systems strip fills the HUD so children can dock to screen edges.
        ^[1].compact.portrait .hud-systems {
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            display: block;
        }

        // Portrait: off-canvas drawer. Body sits off-screen; footer tab is glued to
        // the trailing edge so AFTERBURNER + lamp peek, then the whole tray slides in.
        ^[1].compact.portrait .afterburner-controls {
            position: absolute;
            left: 0;
            right: auto;
            top: auto;
            bottom: 36%;
            flex-direction: column;
            align-items: center;
            gap: 0.28rem;
            padding: 0.22rem 0.28rem;
            border-width: 12px;
            border-image-width: 22px;
            max-width: none;
            overflow: visible;
            transition: transform 0.24s ease;
        }

        ^[1].compact.portrait .afterburner-controls.tray .afterburner-body {
            flex: 0 0 auto;
            max-height: none;
            max-width: none;
            margin: 0;
            opacity: 1;
            overflow: visible;
            transition: none;
        }

        ^[1].compact.portrait .afterburner-controls.tray.collapsed {
            // Park the panel off the left edge; leave a few px so the tab text isn't flush.
            transform: translateX(calc(-100% + 10px));
            padding: 0.22rem 0.28rem;
            border-width: 12px;
            border-image-width: 22px;
            max-width: none;

            .afterburner-body {
                max-width: none;
                max-height: none;
                opacity: 1;
                margin: 0;
                pointer-events: none;
            }
        }

        ^[1].compact.portrait .afterburner-controls.tray.expanded {
            transform: translateX(0);
            border-width: 12px;
            border-image-width: 22px;
            max-width: none;
        }

        // Compact label tab on the trailing edge (not scaled with the dial).
        // Width matches the inventory side tab via --hud-side-tab-* tokens.
        ^[1].compact.portrait .afterburner-footer {
            position: absolute;
            left: 100%;
            top: 50%;
            box-sizing: border-box;
            width: var(--hud-side-tab-width);
            writing-mode: vertical-rl;
            text-orientation: sideways;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            margin: 0;
            padding: var(--hud-side-tab-padding);
            border-style: solid;
            border-color: transparent;
            border-width: var(--hud-side-tab-border-width);
            border-image-source: url("/assets/borders/border-05.png");
            border-image-slice: unquote("80 fill");
            border-image-width: var(--hud-side-tab-border-image-width);
            border-image-repeat: round;
            transform: translateY(-50%) rotate(180deg);
            transform-origin: center center;
            white-space: nowrap;
        }

        ^[1].compact.portrait .afterburner-controls.auto-on .afterburner-footer {
            border-image-source: url("/assets/borders/border-07.png");
        }

        ^[1].compact.portrait .afterburner-lamp {
            margin-top: 0;
            margin-right: 0;
        }

        ^[1].compact.portrait .afterburner-label {
            transform: none;
        }

        // Portrait: slim inventory tab flush on the left, below afterburner — elevator stays clear on the right.
        ^[1].compact.portrait .inventory-button {
            position: absolute;
            left: 0;
            right: auto;
            bottom: 18%;
            box-sizing: border-box;
            width: var(--hud-side-tab-width);
            min-height: 0;
            writing-mode: vertical-rl;
            text-orientation: sideways;
            padding: var(--hud-side-tab-padding);
            border-width: var(--hud-side-tab-border-width);
            border-image-width: var(--hud-side-tab-border-image-width);
            transform: none;
        }

        ^[1].compact.portrait .inventory-label {
            transform: rotate(180deg);
        }

        // Chevron points into the screen to open, back to the edge to close.
        ^[1].compact.portrait .afterburner-controls.tray.collapsed .afterburner-chevron {
            transform: rotate(-90deg);
        }

        ^[1].compact.portrait .afterburner-controls.tray.expanded .afterburner-chevron {
            transform: rotate(90deg);
        }

        ^[1].compact.portrait .threshold-dial {
            width: 88px;
            height: 88px;
        }
        
    }

    #map {
        display: none;
        position: absolute;
        height: @css{ max(12.5dvw, 12.5dvh) };
        width: @css{ max(12.5dvw, 12.5dvh) };
        background: radial-gradient(rgba(#333, 0.15) 5%, rgba(#333, 0.35) 95%);
        border-radius: 100%;
        top: @css{ min(2.5dvw, 2.5dvh) };
        left: @css{ min(2.5dvw, 2.5dvh) };

        #map-fov {
            height: 15px;
            position: absolute;
            left: calc( 50% - 7.5px );
            top: calc( 50% - 7.5px );
            z-index: 2;
        }

        #map-view {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            transform-origin: 50% 50%;

            svg {
                display: block;
                width: 100%;
                height: 100%;
            }
        }

        .marker {
            width: 10px;
            height: 10px;
            position: absolute;
            z-index: 3;
        }
    }

    // Persistent game chrome: available in hangar / flight, hidden on title.
    #fullscreen_toggle {
        position: absolute;
        right: @css{ min(2.5dvw, 2.5dvh) };
        bottom: @css{ min(2.5dvw, 2.5dvh) };
        z-index: 5;
        pointer-events: auto;
        gap: 0;
        padding: 0.2rem 0.25rem 0.1rem;
        color: #fff;
        text-shadow: 0 2px 12px rgba(0, 10, 40, 0.55);
        -webkit-tap-highlight-color: transparent;
        user-select: none;
        -webkit-user-select: none;

        &[hidden] {
            display: none !important;
        }

        .fullscreen_icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.35em;
            height: 1.35em;

            svg {
                display: block;
                width: 100%;
                height: 100%;
            }

            &.exit {
                display: none;
            }
        }

        &.is-fullscreen {
            .fullscreen_icon.enter {
                display: none;
            }

            .fullscreen_icon.exit {
                display: inline-flex;
            }
        }
    }

    #axis_orbit {
        display: none;
        position: absolute;
        left: @css{ min(2.5dvw, 2.5dvh) };
        top: calc(@css{ min(2.5dvw, 2.5dvh) } + @css{ max(12.5dvw, 12.5dvh) } + 0.5rem);
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        z-index: 2;
        pointer-events: none;

        .axis_orbit_canvas {
            width: @css{ max(7.5dvw, 7.5dvh) };
            height: @css{ max(7.5dvw, 7.5dvh) };
            background: transparent;
            overflow: visible;
            pointer-events: none;

            canvas {
                display: block;
                width: 100%;
                height: 100%;
                pointer-events: none;
            }
        }

        .axis_orbit_reset {
            pointer-events: auto;
            padding: 0.15rem 0.25rem 0.05rem;
            font-size: clamp(0.7rem, 1vw, 0.85rem);
            letter-spacing: 0.06em;
            line-height: 1;
            border-width: 12px;
            border-image-width: 24px;
            color: #fff;
        }
    }

}

@keyframes hud-low-power-pulse {
    0%, 100% {
        opacity: 0.45;
    }
    50% {
        opacity: 1;
    }
}

@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

@keyframes scale {
    0%, 100% {
        transform: scale(0.8);
    }
    50% {
        transform: scale(1.2);
    }
}
