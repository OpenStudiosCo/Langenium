
#game_overlay {
    z-index: 4;
    .scanner-target {
        position: absolute;
        z-index: 0;
        
        .targeting-effect {
            display: none;
            width: 40px;
            height: 40px;
            position: absolute;
            right: -7.5px;
            bottom: -7.5px;
            animation: scale 0.6s infinite ease-in-out;

            ^[-1].tracking ^[2..2] {
                display: block;
            }

            ^[-1].locking ^[2..2] {
                animation: scale 0.3s infinite ease-in-out;
            }

            ^[-1].locked ^[2..2] {
                animation: none;
            }

            .border {
                border-radius: 100%;
                border: dashed 1px rgba(200, 0, 200, 1);
                width: 100%;
                height: 100%;
                animation: rotate 5s infinite linear;

                ^[-2].locking ^[3..3] {
                    animation: rotate 2.5s infinite linear;
                }
                ^[-2].locked ^[3..3] {
                    border: ridge 2px rgba(200, 0, 200, 1);
                    animation: none;
                }
            }

        }

        &.aircraft  {
            & path, 
            & rect {
                stroke-width: 20px;
            }
        }

        &.ship {
            & path, 
            & rect {
                stroke-width: 10px;
            }
        }

        &.structure {
            & path, 
            & rect {
                stroke-width: 15px;
            }
        }
    
        .symbol {
            background: none;
            width: 20px;
            height: 20px;

            path, rect {
                stroke: rgba(0, 0, 200, 0.5);
                fill: none;
            }

            ^[-1].tracking ^[2..2] {
                path, rect {
                    fill: rgba(200, 0, 200, 0.5);
                    stroke: rgba(200, 0, 200, 1);
                }
            }
        }

    }

    #hud {
        &-lines {
            position: absolute;
            border-left: 4px ridge rgb(0, 0, 100);
            border-right: 4px ridge rgb(0, 0, 100);
            top: 37.5dvh;
            left: 37.5dvw;
            width: 25dvw;
            height: 25dvh;
            border-radius: 10% / 50%;
            z-index: 2;
            pointer-events: none;
        }

        &-aspd,
        &-vspd,
        &-head,
        &-elev {
            position: absolute;
            color: rgb(0, 0, 100);
            font-family: monospace;
            z-index: 2;
            pointer-events: none;
        }
        &-aspd {
            bottom: 31.25dvh;
            left: 31.25dvw;
        }
        &-vspd {
            bottom: 31.25dvh;
            right: 31.25dvw;
        }
        &-head {
            top: 31.25dvh;
            left: 31.25dvw;
        }
        &-elev {
            top: 31.25dvh;
            right: 31.25dvw;
        }

        &-capacitor {
            position: absolute;
            left: 50%;
            bottom: @css{ min(3.5dvw, 3.5dvh) };
            transform: translateX(-50%);
            width: 216px;
            height: 96px;
            z-index: 2;
            pointer-events: none;
            background: url("/assets/borders/border-09.png") center / 100% 100% no-repeat;

            .track {
                position: absolute;
                left: 18%;
                right: 18%;
                top: 38%;
                bottom: 34%;
                overflow: hidden;
                border-radius: 999px;
                background: rgba(0, 0, 40, 0.55);
            }

            .fill {
                height: 100%;
                width: 100%;
                border-radius: inherit;
                background: linear-gradient(90deg, rgb(20, 90, 180), rgb(80, 180, 255));
                box-shadow: inset 0 0 8px rgba(180, 230, 255, 0.45);
                transition: width 0.12s linear;
            }

            .label {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 10%;
                text-align: center;
                color: rgb(0, 255, 0);
                font-family: monospace;
                font-size: 0.7rem;
                letter-spacing: 0.18em;
            }

            &.draining .fill {
                background: linear-gradient(90deg, rgb(160, 70, 20), rgb(255, 170, 60));
            }

            &.empty .fill {
                width: 0 !important;
                background: rgb(60, 60, 80);
            }
        }
        
        // Portrait mode styles
        ^[1].portrait ^[1..1]-lines {
            left: calc(37.5dvw / 2);
            width: 62.5dvw;
        }

        ^[1].portrait ^[1..1]-aspd {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-vspd {
            right: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-head {
            left: 15.625dvw;
        }
        ^[1].portrait ^[1..1]-elev {
            right: 15.625dvw;
        }

        ^[1].portrait ^[1..1]-capacitor {
            width: 180px;
            height: 80px;
            bottom: @css{ min(2.5dvw, 2.5dvh) };
        }
        
    }

    #map {
        display: none;
        position: absolute;
        height: @css{ max(12.5dvw, 12.5dvh) };
        width: @css{ max(12.5dvw, 12.5dvh) };
        background: radial-gradient(rgba(#333, 0.15) 5%, rgba(#333, 0.35) 95%);
        border-radius: 100%;
        top: @css{ min(2.5dvw, 2.5dvh) };
        left: @css{ min(2.5dvw, 2.5dvh) };

        #map-fov {
            height: 15px;
            position: absolute;
            left: calc( 50% - 7.5px );
            top: calc( 50% - 7.5px );
        }

        .marker {
            width: 10px;
            height: 10px;
            position: absolute;
        }
    }

}

@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

@keyframes scale {
    0%, 100% {
        transform: scale(0.8);
    }
    50% {
        transform: scale(1.2);
    }
}
