#game_dialog
    position: fixed
    inset: 0
    z-index: 7
    display: flex
    align-items: center
    justify-content: center
    padding: 6vw
    box-sizing: border-box
    pointer-events: auto
    color: #fff

    &[hidden]
        display: none

    &.dialog-passive
        pointer-events: none

        .dialog_frame
            pointer-events: auto

    .dialog_label
        position: absolute
        width: 1px
        height: 1px
        padding: 0
        margin: -1px
        overflow: hidden
        clip: rect(0, 0, 0, 0)
        white-space: nowrap
        border: 0

    // Frame chrome comes from .window; dialog only sets its reading width.
    .dialog_frame
        width: min(40rem, 100%)

    .dialog_speaker
        margin: 0 0 0.55rem
        font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
        font-style: italic
        font-weight: 700
        font-size: clamp(1.15rem, 2vw, 1.45rem)
        letter-spacing: 0.08em
        line-height: 1.1
        text-transform: uppercase

    .dialog_text
        margin: 0
        min-height: 1.2em
        font-family: system-ui, sans-serif
        font-size: clamp(1.05rem, 2vw, 1.3rem)
        line-height: 1.45
        letter-spacing: 0.03em
        text-transform: none

    .dialog_caret
        display: inline-block
        width: 0.55ch
        height: 0.85em
        margin-left: 0.08em
        background: #fff
        vertical-align: -0.05em
        animation: dialog_caret 1s steps(1) infinite

    &.dialog-written .dialog_caret
        display: none

    .dialog_actions
        display: grid
        grid-template-rows: 0fr
        margin-top: 0
        opacity: 0
        pointer-events: none
        transition: grid-template-rows 640ms cubic-bezier(0.22, 1, 0.36, 1), margin-top 640ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms ease 80ms

    .dialog_actions_row
        display: flex
        flex-wrap: wrap
        gap: 0.4rem 1.4rem
        min-height: 0
        overflow: hidden

    &.dialog-written .dialog_actions
        grid-template-rows: 1fr
        margin-top: 1.35rem
        opacity: 1
        pointer-events: auto

    // Actions use .window_action; bump type slightly for spoken lines.
    .dialog_action
        font-size: clamp(0.95rem, 1.4vw, 1.15rem)

    @media (max-width: 720px)
        padding: 1.25rem

        .dialog_action
            border-width: 32px
            border-image-width: 32px
            padding: 0.1rem 0.9rem 0.15rem

    @media (prefers-reduced-motion: reduce)
        .dialog_actions
            transition: none

        .dialog_caret
            animation: none

@keyframes dialog_caret
    0%, 50%
        opacity: 1
    50.01%, 100%
        opacity: 0
