#game_dialog
    position: fixed
    inset: 0
    z-index: 7
    display: flex
    align-items: center
    justify-content: center
    padding: 6vw
    box-sizing: border-box
    pointer-events: auto
    color: #fff

    &[hidden]
        display: none

    .dialog_label
        position: absolute
        width: 1px
        height: 1px
        padding: 0
        margin: -1px
        overflow: hidden
        clip: rect(0, 0, 0, 0)
        white-space: nowrap
        border: 0

    .dialog_frame
        box-sizing: border-box
        width: min(40rem, 100%)
        padding: 1.35rem 1.5rem 1.25rem
        border-style: solid
        border-color: transparent
        border-width: 40px
        border-image-source: url("/assets/borders/border-02.png")
        border-image-slice: unquote("40 fill")
        border-image-width: 40px
        border-image-repeat: round
        background-color: transparent
        background-clip: padding-box
        text-shadow: 0 2px 12px rgba(0, 10, 40, 0.55)

    .dialog_speaker
        margin: 0 0 0.55rem
        font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
        font-style: italic
        font-weight: 700
        font-size: clamp(1.15rem, 2vw, 1.45rem)
        letter-spacing: 0.08em
        line-height: 1.1
        text-transform: uppercase

    .dialog_text
        margin: 0
        min-height: 4.8em
        font-family: system-ui, sans-serif
        font-size: clamp(1.05rem, 2vw, 1.3rem)
        line-height: 1.45
        letter-spacing: 0.03em
        text-transform: none

    .dialog_caret
        display: inline-block
        width: 0.55ch
        height: 0.85em
        margin-left: 0.08em
        background: #fff
        vertical-align: -0.05em
        animation: dialog_caret 1s steps(1) infinite

    &.dialog-written .dialog_caret
        display: none

    .dialog_actions
        display: none
        flex-wrap: wrap
        gap: 0.4rem 1.4rem
        margin-top: 1.35rem

    &.dialog-written .dialog_actions
        display: flex

    .dialog_action
        display: inline-block
        background-color: transparent
        background-image: linear-gradient(rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.72))
        background-repeat: no-repeat
        background-position: left bottom
        background-size: 0 1px
        border: 0
        padding: 0 0.15em 0.14em 0
        color: inherit
        font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
        font-style: italic
        font-weight: 700
        font-size: clamp(1.55rem, 2.6vw, 2.15rem)
        letter-spacing: 0.06em
        line-height: 1.1
        text-transform: uppercase
        cursor: pointer
        transition: background-size 520ms cubic-bezier(0.16, 1, 0.3, 1)

        &:hover,
        &:focus-visible
            background-size: 100% 1px

        &:focus-visible
            outline: 1px solid rgba(255, 255, 255, 0.65)
            outline-offset: 6px

    @media (max-width: 720px)
        padding: 1.25rem

        .dialog_frame
            border-width: 28px
            border-image-width: 28px
            padding: 1rem 1.05rem 0.95rem

    @media (prefers-reduced-motion: reduce)
        .dialog_caret
            animation: none

@keyframes dialog_caret
    0%, 50%
        opacity: 1
    50.01%, 100%
        opacity: 0
