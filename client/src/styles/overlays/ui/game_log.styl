#game_log
    position: fixed
    left: 50%
    // Two lines higher than the capacitor / systems HUD row.
    bottom: @css{ calc(10.65rem + min(3.5dvw, 3.5dvh)) }
    transform: translateX(-50%)
    z-index: 4
    width: @css{ min(34rem, calc(100vw - 2rem)) }
    max-width: 92vw
    pointer-events: none
    color: #fff !important
    // Hard outline so lines stay readable over bright water / sky.
    text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 0 0 4px #000, 0 2px 6px rgba(0, 0, 0, 0.85)

    &[hidden]
        display: none !important

    // Portrait phones: drop the open button into the gap between the inventory
    // side tab and the D-pad so it no longer covers inventory.
    @media (orientation: portrait)
        bottom: @css{ calc(6.25rem + min(2.5dvw, 2.5dvh)) }

    .game_log_panel
        display: flex
        flex-direction: row
        align-items: flex-end
        gap: 0.45rem

    .game_log_open
        flex: 0 0 auto
        order: 0
        pointer-events: auto
        gap: 0
        padding: 0.2rem 0.25rem 0.1rem
        color: #fff
        text-shadow: 0 2px 12px rgba(0, 10, 40, 0.55)
        opacity: 0.95

    .game_log_open_icon
        display: inline-flex
        align-items: center
        justify-content: center
        width: 1.25em
        height: 1.25em

        svg
            display: block
            width: 100%
            height: 100%

    .game_log_feed
        flex: 1 1 auto
        order: 1
        max-height: 7.5em
        overflow-y: auto
        padding: 0.2rem 0.35rem
        box-sizing: border-box
        pointer-events: auto
        background: transparent
        border: 0
        font-family: system-ui, sans-serif
        font-size: @css{ clamp(0.82rem, 1.35vw, 0.98rem) }
        line-height: 1.45
        letter-spacing: 0.02em
        color: #fff !important
        text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 0 0 4px #000, 0 2px 6px rgba(0, 0, 0, 0.85)
        scrollbar-width: thin
        scrollbar-color: rgba(255, 255, 255, 0.28) transparent

        &::-webkit-scrollbar
            width: 5px

        &::-webkit-scrollbar-track
            background: transparent

        &::-webkit-scrollbar-thumb
            background: rgba(255, 255, 255, 0.28)
            border-radius: 999px

        &::-webkit-scrollbar-thumb:hover
            background: rgba(255, 255, 255, 0.45)

    .game_log_entry
        margin: 0 0 0.15rem
        color: #fff !important

        &:last-child
            margin-bottom: 0

    .game_log_emphasis
        font-weight: 700
        color: #fff !important

    img.game_log_icon
        display: inline-block !important
        width: 1em !important
        height: 1em !important
        max-width: 1em !important
        max-height: 1em !important
        margin: 0 0.2em -0.12em 0.08em !important
        vertical-align: baseline !important
        object-fit: contain !important

#game_log_full
    position: fixed
    inset: 0
    z-index: 7
    display: flex
    align-items: center
    justify-content: center
    padding: 6vw
    box-sizing: border-box
    pointer-events: auto
    color: #fff

    &[hidden]
        display: none

    .game_log_full_frame
        width: @css{ min(40rem, 100%) }
        max-height: @css{ min(70vh, 36rem) }
        display: flex
        flex-direction: column
        box-sizing: border-box

    .game_log_tabs
        display: flex
        flex-wrap: wrap
        gap: 0.45rem 0.85rem
        margin-top: 0.55rem

    .game_log_tab
        margin: 0
        padding: 0.15rem 0.1rem
        border: 0
        background: transparent
        color: rgba(255, 255, 255, 0.55)
        font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
        font-style: italic
        font-weight: 700
        font-size: @css{ clamp(0.9rem, 1.3vw, 1.05rem) }
        letter-spacing: 0.08em
        line-height: 1.1
        text-transform: uppercase
        cursor: pointer

        &:hover,
        &:focus-visible
            color: rgba(255, 255, 255, 0.9)
            outline: none

        &.is-active
            color: #fff
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.35)
            border-bottom: 1px solid rgba(255, 255, 255, 0.75)

    .game_log_full_body
        flex: 1 1 auto
        min-height: 8rem
        max-height: @css{ min(48vh, 26rem) }
        overflow-y: auto
        margin: 0.65rem 0 0.85rem
        padding-right: 0.45rem
        font-family: system-ui, sans-serif
        font-size: @css{ clamp(1.05rem, 2vw, 1.3rem) }
        line-height: 1.45
        letter-spacing: 0.03em
        color: #fff
        text-transform: none
        scrollbar-width: thin
        scrollbar-color: rgba(255, 255, 255, 0.28) transparent

        &::-webkit-scrollbar
            width: 6px

        &::-webkit-scrollbar-track
            background: transparent

        &::-webkit-scrollbar-thumb
            background: rgba(255, 255, 255, 0.28)
            border-radius: 999px

        &::-webkit-scrollbar-thumb:hover
            background: rgba(255, 255, 255, 0.45)

    .game_log_full_actions
        display: flex
        justify-content: flex-end
        margin-top: 0.35rem

    .game_log_entry
        margin: 0 0 0.55rem
        color: #fff

        &:last-child
            margin-bottom: 0

    .game_log_emphasis
        font-weight: 700

    img.game_log_icon
        display: inline-block !important
        width: 1em !important
        height: 1em !important
        max-width: 1em !important
        max-height: 1em !important
        margin: 0 0.25em -0.12em 0.1em !important
        vertical-align: baseline !important
        object-fit: contain !important
