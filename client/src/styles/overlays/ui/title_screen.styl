#ui_overlay #title_screen
    position: absolute
    top: 0
    left: 0
    height: 100%
    display: none
    flex-direction: column
    justify-content: flex-start
    align-items: flex-start
    padding: 12vh 0 0 6vw
    box-sizing: border-box
    pointer-events: none
    color: #fff
    text-transform: uppercase
    user-select: none

    &.active
        display: flex

    nav,
    .title_screen_detail
        pointer-events: auto

    .title_screen_logo
        width: unquote("min(42vw, 28rem)")
        height: 14vh
        margin-bottom: 6vh
        flex: 0 0 auto
        transform-origin: top left
        transition: transform 720ms cubic-bezier(0.16, 1, 0.3, 1)

    nav
        pointer-events: auto

    ul
        list-style: none
        margin: 0
        padding: 0

    button
        display: block
        position: relative
        background-color: transparent
        background-image: linear-gradient(rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.72))
        background-repeat: no-repeat
        background-position: left bottom
        background-size: 0 1px
        border: 0
        padding: 0 0.15em 0.14em 0
        color: inherit
        font: inherit
        text-transform: uppercase
        text-align: left
        cursor: pointer
        text-shadow: 0 2px 16px rgba(0, 10, 40, 0.45)
        transition: background-size 520ms cubic-bezier(0.16, 1, 0.3, 1)

        &:hover,
        &:focus-visible,
        &.selected
            background-size: 100% 1px

        &:focus-visible
            outline: 1px solid rgba(255, 255, 255, 0.65)
            outline-offset: 6px

        &:disabled,
        &:disabled:hover,
        &:disabled:focus-visible
            opacity: 0.35
            background-size: 0 1px
            cursor: default

            &::before,
            &::after,
            > span
                animation: none
                opacity: 0

    &.panel-open nav button:not(.selected)
        opacity: 0.45

        &:hover,
        &:focus-visible
            opacity: 1

    .primary
        font-size: clamp(3.4rem, 7.2vw, 6.6rem)

        li + li
            margin-top: 0.22em

        button
            font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
            font-style: italic
            font-weight: 700
            font-stretch: condensed
            font-size: 1em
            line-height: 1.08
            letter-spacing: 0.03em

            // Roman ghost of the same word, shown only as two thin bands.
            // It disagrees with the italic for a moment, then disappears.
            &::before,
            &::after
                content: attr(data-label)
                position: absolute
                left: 0
                top: 0
                width: 100%
                font-style: normal
                font-weight: 700
                letter-spacing: 0.03em
                color: #fff
                text-shadow: none
                pointer-events: none
                opacity: 0

            &::before
                clip-path: inset(32% 0 54% 0)

            &::after
                clip-path: inset(64% 0 20% 0)

            > span
                position: absolute
                left: -0.04em
                top: 50%
                z-index: 1
                font-size: 1.78em
                line-height: 0.85
                white-space: nowrap
                pointer-events: none
                color: #fff
                text-shadow: none
                opacity: 0
                mix-blend-mode: screen
                transform: translate3d(0, -50%, 0) scale(0.96)
                transform-origin: left center

            &:hover,
            &:focus-visible
                &::before
                    animation: title_band 0.72s cubic-bezier(0.22, 1, 0.36, 1)

                &::after
                    animation: title_band_late 0.84s cubic-bezier(0.22, 1, 0.36, 1)

                > span
                    animation: title_bloom 0.82s cubic-bezier(0.16, 1, 0.3, 1)

    .secondary
        margin-top: 2.1rem
        font-size: clamp(1.15rem, 2vw, 1.65rem)

        li + li
            margin-top: 0.42em

        button
            font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
            font-weight: 600
            font-stretch: condensed
            font-size: 1em
            line-height: 1.15
            letter-spacing: 0.12em

            > span
                position: absolute
                left: 0
                top: 50%
                font-size: 1.55em
                line-height: 1
                white-space: nowrap
                pointer-events: none
                color: #fff
                text-shadow: none
                opacity: 0
                mix-blend-mode: screen
                transform: translate3d(0, -50%, 0)
                transform-origin: left center

            &:hover,
            &:focus-visible
                > span
                    animation: title_bloom 0.82s cubic-bezier(0.16, 1, 0.3, 1)

    .title_screen_detail
        position: absolute
        left: unquote("min(46vw, 34rem)")
        top: 30vh
        width: unquote("min(24rem, 40vw)")
        max-height: 62vh
        transition: top 720ms cubic-bezier(0.16, 1, 0.3, 1)
        overflow-y: auto
        scrollbar-width: thin
        scrollbar-color: rgba(255, 255, 255, 0.45) transparent
        pointer-events: auto
        text-shadow: 0 2px 12px rgba(0, 10, 40, 0.45)

        h2
            margin: 0 0 0.75rem
            font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
            font-size: clamp(1.4rem, 2.4vw, 2rem)
            font-weight: 700
            letter-spacing: 0.08em

        p,
        label,
        li
            font-family: system-ui, sans-serif
            font-size: 1rem
            line-height: 1.45
            letter-spacing: 0.04em
            text-transform: none

        ul
            margin-top: 0.5rem

        li + li
            margin-top: 0.65rem

        button
            font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
            font-size: clamp(1.4rem, 2.2vw, 1.9rem)
            font-weight: 700
            letter-spacing: 0.06em
            text-transform: uppercase

        label
            display: flex
            align-items: center
            gap: 0.6rem
            margin: 0.45rem 0
            cursor: pointer

        [data-panel="settings"] input
            width: 1rem
            height: 1rem
            margin: 0
            accent-color: #fff

        [data-panel="settings"] label:has(input:disabled)
            opacity: 0.4
            cursor: default

        [data-panel="stories"]
            h2
                margin-bottom: 1.15rem
                font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
                font-style: italic
                font-weight: 700
                font-stretch: condensed
                font-size: clamp(2.15rem, 3.2vw, 2.85rem)
                line-height: 1
                letter-spacing: 0.02em

            p
                margin: 0
                max-width: 36ch

            .story_synopsis
                margin-bottom: 1.5rem

                p + p
                    margin-top: 0.8rem

            .story_parts
                margin: 0
                padding: 0
                list-style: none

                li
                    display: block
                    margin: 0
                    padding: 0
                    border-top: 1px solid rgba(255, 255, 255, 0.72)
                    box-shadow: inset 0 1px 0 rgba(0, 8, 30, 0.28)

                    &:last-child
                        border-bottom: 1px solid rgba(255, 255, 255, 0.72)
                        box-shadow: inset 0 1px 0 rgba(0, 8, 30, 0.28), inset 0 -1px 0 rgba(0, 8, 30, 0.28)

                button
                    display: grid
                    grid-template-columns: 2.25rem minmax(0, 1fr) auto
                    column-gap: 0.8rem
                    align-items: baseline
                    width: 100%
                    margin: 0
                    padding: 0.7rem 0
                    font-family: inherit
                    font-size: inherit
                    font-weight: inherit
                    letter-spacing: inherit
                    line-height: inherit
                    text-transform: none

            .story_index
                font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
                font-weight: 700
                font-size: 0.95rem
                letter-spacing: 0.12em
                opacity: 0.72

            .story_name
                display: flex
                flex-direction: column
                align-items: flex-start
                gap: 0.18rem
                font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
                font-weight: 700
                font-size: clamp(1.2rem, 1.8vw, 1.5rem)
                letter-spacing: 0.03em
                line-height: 1.15

            .story_by
                font-family: system-ui, sans-serif
                font-size: 0.72rem
                font-weight: 500
                letter-spacing: 0.04em
                line-height: 1.2
                text-transform: none
                opacity: 0.75

            .story_time
                font-size: 0.78rem
                letter-spacing: 0.08em
                opacity: 0.75
                white-space: nowrap

            .story_note
                margin-top: 1.05rem
                font-size: 0.9rem
                line-height: 1.45
                opacity: 0.82

        .story_reader
            h2
                margin-bottom: 0.35rem
                font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
                font-style: italic
                font-weight: 700
                font-stretch: condensed
                line-height: 1
                letter-spacing: 0.02em

            .story_by
                margin: 0 0 1.15rem
                font-size: 0.95rem

        .story_text
            max-width: 68ch
            user-select: text
            text-transform: none

            p
                margin: 0 0 0.95rem
                max-width: none
                font-size: clamp(1.02rem, 1.25vw, 1.16rem)
                line-height: 1.6

            .story_act
                margin-top: 1.8rem
                font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
                font-size: clamp(1.2rem, 1.8vw, 1.45rem)
                font-weight: 700
                letter-spacing: 0.08em
                line-height: 1.2

            hr
                width: 3.25rem
                height: 0
                margin: 0.2rem 0 1.15rem
                border: 0
                border-top: 1px solid rgba(255, 255, 255, 0.55)

            a,
            .story_ref
                display: inline
                padding: 0
                background-image: none
                font: inherit
                letter-spacing: inherit
                line-height: inherit
                text-transform: none
                text-decoration: underline
                text-underline-offset: 0.16em
                cursor: pointer

            figure
                margin: 0.35rem 0 1.15rem

            img
                display: block
                width: 100%
                max-width: 40rem
                height: auto

        [data-panel="about"] p,
        [data-panel="lore"] p,
        [data-panel="help"] p
            margin: 0 0 0.75rem

        [data-panel="help"]
            h3
                margin: 1.15rem 0 0.4rem
                font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
                font-size: clamp(1.05rem, 1.5vw, 1.2rem)
                font-weight: 700
                letter-spacing: 0.12em

            h3:first-of-type
                margin-top: 0.2rem

        .panel_body
            position: relative
            box-sizing: border-box
            padding: 1.15rem 1.25rem 1.2rem
            border-style: solid
            border-color: transparent
            border-width: 80px
            border-image-source: url("/assets/borders/border-01.png")
            border-image-slice: unquote("80 fill")
            border-image-width: 80px
            border-image-repeat: round
            background-color: transparent
            background-clip: padding-box

        // Restore dialog chrome — `#title_screen button { border: 0 }` otherwise kills border-image.
        button.window_action
            display: inline-flex
            align-items: center
            justify-content: center
            box-sizing: border-box
            width: max-content
            max-width: max-content
            margin: 0
            padding: 0.25rem 0.35rem 0.15rem
            border-style: solid
            border-color: transparent
            border-width: 20px
            border-image-source: url("/assets/borders/border-05.png")
            border-image-slice: unquote("80 fill")
            border-image-width: 40px
            border-image-repeat: round
            background-color: transparent
            background-image: none
            background-clip: padding-box
            background-size: auto
            color: inherit
            font-family: "Liberation Sans Narrow", "Nimbus Sans Narrow", "Arial Narrow", "Helvetica Condensed", sans-serif
            font-style: italic
            font-weight: 700
            font-size: clamp(0.9rem, 1.3vw, 1.05rem)
            letter-spacing: 0.08em
            line-height: 1.1
            text-transform: uppercase
            text-shadow: 0 2px 12px rgba(0, 10, 40, 0.55)

            &:hover,
            &:focus-visible,
            &:active,
            &.selected
                border-image-source: url("/assets/borders/border-07.png")
                background-size: auto

            &:focus-visible
                outline: none

        button.window_action.dialog_action
            font-size: clamp(0.95rem, 1.4vw, 1.15rem)

        .panel_header
            display: flex
            // Portrait default: Back on its own line above the title, right-aligned.
            flex-direction: column
            align-items: stretch
            gap: 0.45rem
            margin: 0 0 0.75rem

            h2
                flex: 1 1 auto
                min-width: 0
                margin: 0
                order: 2

            .panel_back
                order: 1
                align-self: flex-end

        button.panel_back
            flex: 0 0 auto
            margin: 0

        @media (orientation: landscape)
            .panel_header
                flex-direction: row
                align-items: flex-start
                justify-content: space-between
                gap: 0.75rem 1rem

                h2
                    order: 0

                .panel_back
                    order: 0
                    align-self: flex-start

        a
            color: inherit

    &.help-session
        .title_screen_logo,
        nav
            display: none

    @media (max-width: 720px) and (min-height: 521px)
        padding: 4.5vh 1.25rem 1.5rem
        overflow-x: hidden
        overflow-y: auto

        .title_screen_logo
            width: unquote("min(78vw, 16rem)")
            height: 9vh
            margin-bottom: 2vh

        nav
            flex: 1 1 auto
            display: flex
            flex-direction: column
            justify-content: space-between
            width: 100%

        .primary
            position: absolute
            top: 50%
            left: 1.25rem
            transform: translateY(-50%)
            font-size: clamp(2.75rem, 15vw, 4.6rem)

            li + li
                margin-top: 0.28em

        .secondary
            margin-top: auto
            padding-bottom: 0.25rem

        .title_screen_detail
            position: static
            top: auto
            left: auto
            width: auto
            max-width: 100%
            margin-top: 1.5rem

    @media (max-height: 520px)
        padding: 0.7rem 1.5rem 0.65rem
        overflow-x: hidden
        overflow-y: auto

        .title_screen_logo
            width: unquote("min(42vw, 22rem)")
            height: 18vh
            margin-bottom: 0.65rem

        nav
            flex: 0 0 auto
            display: block

        .primary
            font-size: clamp(2.15rem, 10vh, 3.8rem)

            li + li
                margin-top: 0.42em

        .secondary
            margin-top: 1.15rem
            font-size: clamp(1.05rem, 4.6vh, 1.4rem)

            li + li
                margin-top: 0.55em

        .title_screen_detail
            left: auto
            right: 3vw
            top: 0.7rem
            width: unquote("min(20rem, 42vw)")
            max-height: unquote("calc(100vh - 1.4rem)")
            max-width: none

    &.panel-open
        right: 0
        align-items: stretch
        overflow-y: auto

        nav
            display: none

        // Sub-screens keep only Back — logo / version stay on the main menu.
        .title_screen_logo,
        .title_engine
            display: none

        .title_screen_detail
            position: absolute
            inset: 1.15rem 6vw 6vw
            display: flex
            flex-direction: column
            width: auto
            max-width: none
            max-height: none
            margin: 0
            overflow: hidden
            transform: none

            [data-panel][hidden]
                display: none !important

            [data-panel]:not([hidden])
                flex: 1 1 auto
                min-height: 0
                display: flex
                flex-direction: column
                overflow: hidden

                h2
                    font-size: clamp(2.75rem, 4.6vw, 4.6rem)

                p
                    max-width: 68ch

                .panel_body
                    flex: 1 1 auto
                    min-height: 0
                    display: flex
                    flex-direction: column
                    overflow-x: hidden
                    overflow-y: auto
                    scrollbar-width: thin
                    scrollbar-color: rgba(255, 255, 255, 0.45) transparent
                    padding: clamp(1.6rem, 3vh, 2.6rem) clamp(1.6rem, 3vw, 3.2rem)

                    .panel_header
                        flex: 0 0 auto
                        margin-bottom: 0.55rem

                    button.panel_back
                        background-color: transparent

            [data-panel="play"]
                h2
                    margin-bottom: 0.35rem

                > .panel_body > p
                    margin-bottom: 0

                .save_slots
                    flex: 1 1 auto
                    min-height: 0
                    margin-top: 0.85rem

            [data-panel="stories"] .story_name
                font-size: clamp(1.35rem, 2.2vw, 2.05rem)

        @media (max-width: 720px)
            .title_screen_detail
                inset: 1rem 1.25rem 1.25rem

                [data-panel]:not([hidden])
                    h2
                        font-size: clamp(2.15rem, 9vw, 3rem)

                    .panel_body
                        padding: 1.25rem 1.15rem 1.2rem
                        border-width: 56px
                        border-image-width: 56px

        // Portrait: widen the reading area — less outer gutter, thinner frame chrome.
        @media (orientation: portrait)
            .title_screen_detail
                inset: 0.45rem 0.4rem 0.55rem

                [data-panel]:not([hidden])
                    p
                        max-width: none

                    .panel_body
                        padding: 0.95rem 0.85rem 1rem
                        border-width: 36px
                        border-image-width: 36px

                    .panel_header
                        margin-bottom: 0.45rem

        @media (max-height: 520px)
            .title_screen_detail
                inset: 0.45rem 0.85rem 0.45rem

                [data-panel]:not([hidden])
                    h2
                        font-size: clamp(1.55rem, 6.5vh, 2.35rem)
                        margin-bottom: 0.25rem

                    .panel_body
                        border-width: 36px
                        border-image-width: 36px
                        padding: 0.55rem 0.7rem 0.6rem

                        button.window_action
                            border-width: 16px
                            border-image-width: 28px
                            padding: 0.1rem 0.35rem 0.1rem

                        .panel_header
                            margin-bottom: 0.35rem

                [data-panel="play"]
                    > .panel_body > p
                        font-size: 0.9rem
                        line-height: 1.3

                    .save_slots
                        margin-top: 0.55rem
                        gap: 0.45rem

    .title_engine,
    .title_studio
        pointer-events: auto
        color: inherit
        text-decoration: none

    .title_engine
        position: fixed
        top: 1.15rem
        right: 1.4rem
        z-index: 2
        font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
        font-weight: 700
        font-size: clamp(1.05rem, 1.7vw, 1.4rem)
        letter-spacing: 0.14em
        text-transform: none
        text-shadow: 0 2px 16px rgba(0, 10, 40, 0.45)

        &:hover,
        &:focus-visible
            text-decoration: underline

        &:focus-visible
            outline: 1px solid rgba(255, 255, 255, 0.65)
            outline-offset: 6px

    .title_studio
        position: fixed
        right: 1.35rem
        bottom: 1.15rem
        z-index: 2
        width: unquote("min(10.5rem, 32vw)")
        line-height: 0

        img
            display: block
            width: 100%
            height: auto

    &.panel-open .title_studio
        visibility: hidden
        pointer-events: none

#ui_overlay .session_chrome
    position: fixed
    top: 1.15rem
    right: 1.4rem
    z-index: 6
    display: flex
    align-items: center
    gap: 0.55rem
    pointer-events: auto

    &[hidden]
        display: none !important

    // Match hangar dialog Enter / Cancel chrome.
    .window_action
        gap: 0.45rem
        color: #fff
        text-shadow: 0 2px 12px rgba(0, 10, 40, 0.55)
        transition: opacity 240ms ease

        &:focus-visible
            outline: none

#ui_overlay #save_game
    .save_icon
        display: inline-flex
        align-items: center
        justify-content: center
        // Match EXIT cap-height; stroked SVG reads smaller than bold italic type.
        width: 1.15em
        height: 1.15em
        opacity: 0.95

        svg
            display: block
            width: 100%
            height: 100%

    .save_label
        display: inline

    // Portrait phones: icon only so Save does not cover the capacitor gauge.
    @media (orientation: portrait)
        .save_label
            display: none

        .save_icon
            width: 1.35em
            height: 1.35em

    &.is-saving
        opacity: 0.55

    &.is-saved .save_icon
        color: #9dffb0

    &.is-error
        color: #ffb4b4

#ui_overlay #title_screen .save_slots
    display: grid
    // Portrait: one card per row. Landscape: three columns.
    grid-template-columns: 1fr
    gap: 0.75rem
    margin: 1.25rem 0 0
    padding: 0
    list-style: none

    // Slot contents always stack — never squeeze into inner columns.
    .save_slot
        display: flex
        flex-direction: column
        align-items: stretch
        gap: 0.45rem
        min-width: 0
        margin: 0
        padding: 0.75rem 0.8rem
        border: 1px solid rgba(255, 255, 255, 0.55)
        box-shadow: inset 0 1px 0 rgba(0, 8, 30, 0.28)

    .save_slot_index
        font-family: "Arial Narrow", "Nimbus Sans Narrow", "Helvetica Condensed", sans-serif
        font-weight: 700
        letter-spacing: 0.08em
        opacity: 0.72

    .save_slot_body
        display: flex
        flex-direction: column
        gap: 0.2rem
        min-width: 0

    .save_slot_title
        font-weight: 700
        line-height: 1.15

    .save_slot_detail
        opacity: 0.72
        font-size: 0.82em
        line-height: 1.25

    .save_slot_actions
        display: flex
        flex-direction: row
        flex-wrap: wrap
        align-items: center
        gap: 0.65rem 0.85rem
        margin-top: 0.35rem

        .window_action
            white-space: nowrap

        .save_slot_new
            opacity: 0.85

    @media (orientation: landscape)
        grid-template-columns: repeat(3, minmax(0, 1fr))
        gap: 0.65rem

        .save_slot
            gap: 0.35rem
            padding: 0.55rem 0.6rem

        .save_slot_actions
            flex-direction: column
            align-items: stretch
            // Touch-friendly gap between Continue / New Game.
            gap: 0.7rem
            margin-top: auto

            .window_action
                width: 100%
                max-width: none
                justify-content: center

    @media (orientation: landscape) and (max-height: 520px)
        gap: 0.4rem
        margin-top: 0.55rem

        .save_slot
            padding: 0.4rem 0.5rem
            gap: 0.2rem

        .save_slot_index
            font-size: 0.9em

        .save_slot_title
            font-size: 0.95em

        .save_slot_detail
            font-size: 0.75em

        .save_slot_actions
            gap: 0.55rem

            .window_action
                border-width: 16px
                border-image-width: 28px
                font-size: 0.85rem

@keyframes title_bloom
    0%
        opacity: 0
        transform: translate3d(0, -48%, 0) scale(0.94)
    14%
        opacity: 0.42
        transform: translate3d(-0.02em, -52%, 0) scale(1)
    100%
        opacity: 0
        transform: translate3d(-0.05em, -58%, 0) scale(1.07)

@keyframes title_band
    0%
        opacity: 0
        transform: translate3d(0, 0, 0)
    16%
        opacity: 0.92
        transform: translate3d(0.06em, 0, 0)
    38%
        opacity: 0.5
        transform: translate3d(-0.085em, 0, 0)
    68%
        opacity: 0.16
        transform: translate3d(0.02em, 0, 0)
    100%
        opacity: 0
        transform: translate3d(0, 0, 0)

@keyframes title_band_late
    0%,
    10%
        opacity: 0
        transform: translate3d(0, 0, 0)
    32%
        opacity: 0.8
