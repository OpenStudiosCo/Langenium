//- Home-mode front menu.
//- The logo region is empty on purpose: the extruded SVG mesh is added in the scene later and occupies this space.
#title_screen
    .title_screen_logo(data-mount="langenium-logo" aria-hidden="true")
    nav(aria-label="Main menu")
        ul.primary
            li
                button(type="button" data-action="play" data-label="Play")
                    span(aria-hidden="true") Play
                    | Play
            li
                button(type="button" data-action="stories" data-label="Stories")
                    span(aria-hidden="true") Stories
                    | Stories
            li
                button(type="button" data-action="lore" data-label="Lore")
                    span(aria-hidden="true") Lore
                    | Lore
        ul.secondary
            li
                button(type="button" data-action="settings")
                    span(aria-hidden="true") Settings
                    | Settings
            li
                button(type="button" data-action="help")
                    span(aria-hidden="true") Help
                    | Help
            li
                button(type="button" data-action="about")
                    span(aria-hidden="true") About
                    | About
    .title_screen_detail
        section(data-panel="stories" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2
                    | The Langenium
                    br
                    | Prologue Trilogy
                .story_synopsis
                    p This is a series of short stories that sets up the setting of the Langenium game world. I recommend reading them in order, however, they are told as standalone short stories that can be read on their own.
                    p In the near future, human civilisation is in decline.
                    p Following decades of conflict between nations, technology companies no longer produce the components needed to power the age of computing. The creation of an AI that can help humanity seems all but out of reach.
                    p Deep in the frozen tundra of Canada there is hope. His name is Geoffrey Weyun. Geoffrey believes he and his online friends can build a new AI that will help rebuild what’s been lost.
                    p He has no idea what he’s about to set in motion.
                    p In New York City, Kate O’Connor is addressing the UN about a new medical breakthrough. FBI Agent Tim Goth is investigating an international crime ring conducting experiments that may hold the secret to immortality. And Robert Francisco, one of the world’s most famous actors, finds himself in a relationship unlike any he has known before.
                ol.story_parts
                    li
                        button(type="button" data-read="story-end-of-all-limits")
                            span.story_index(aria-hidden="true") 01
                            span.story_name The End of All Limits
                            span.story_time 25 min
                    li
                        button(type="button" data-read="story-hell-on-earth")
                            span.story_index(aria-hidden="true") 02
                            span.story_name Hell on Earth
                            span.story_time 90 min
                    li
                        button(type="button" data-read="story-extinction-level-event")
                            span.story_index(aria-hidden="true") 03
                            span.story_name Extinction Level Event
                            span.story_time 95 min
                p.story_note About three and a half hours.
        section.story_reader(data-panel="story-end-of-all-limits" data-return="stories" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 The End of All Limits
                .story_text
                    include ./stories/end_of_all_limits.html
        section.story_reader(data-panel="story-hell-on-earth" data-return="stories" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 Hell on Earth
                .story_text
                    include ./stories/hell_on_earth.html
        section.story_reader(data-panel="story-extinction-level-event" data-return="stories" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 Extinction Level Event
                .story_text
                    include ./stories/extinction_level_event.html
        section(data-panel="lore" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 Lore
                p Coming soon
        //- Visual only. These boxes are not bound to l.config.settings.
        section(data-panel="settings" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 Settings
                label
                    input(type="checkbox" tabindex="-1")
                    span Debugging mode
                label
                    input(type="checkbox" tabindex="-1")
                    span Performance mode
                label
                    input(type="checkbox" tabindex="-1")
                    span Skip title sequence
        section(data-panel="about" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 About
                p Langenium is an open source game project with the long term goal of producing an MMO in the browser.
                p Starting in 2012, the current build of Langenium is a culmination of over a decade of work.
                p Please enjoy this current version of the game!
                p
                    | Langenium 
                    span(data-version)
                p
                    | p.s. If you are a developer or interested in games development, visit Langenium on 
                    a(href="https://github.com/OpenStudiosCo/Langenium" target="_blank" rel="noopener") Github
        section(data-panel="help" hidden)
            button.panel_back(type="button" data-action="close-panel") Back
            .panel_body
                h2 Help
                h3 Gameplay
                p Bots and players use the same scanner and weapons subsystems for combat.
                h3 PC Controls
                p [W][A][S][D] to turn your aircraft and control acceleration.
                p [Shift] and [Spacebar] to control your aircrafts elevation.
                h3 On-screen controls
                p These controls are always visible and therefore usable using your mouse on PC and touch on mobile and other touchscreen devices.
                p The D-PAD in the bottom left can be used like a thumbstick to turn your aircraft and control acceleration.
                p The slider on the right controls elevation and the camera button can be used to peak around the scene.
                p The weapons console can be used to toggle auto attack and manually fire weapons if auto attack is off.
                p When weapons fire, the attack button shows the time remaining till the next attack is ready.
